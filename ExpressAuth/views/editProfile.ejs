<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Update Profile</title>

    <!-- Tailwind CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>

<body class="bg-gray-100 min-h-screen flex items-center justify-center px-4">

    <!-- MAIN WRAPPER -->
    <main class="bg-white p-8 md:p-10 rounded-2xl shadow-xl w-full max-w-md">

        <!-- Back Button -->
        <a href="/profile" class="inline-flex items-center text-blue-600 font-semibold hover:text-blue-800 mb-5">
            <i class="fas fa-arrow-left mr-2"></i> Back
        </a>

        <!-- Heading -->
        <h1 class="text-2xl font-bold text-gray-700 text-center">
            Update Profile
        </h1>
        <p class="text-gray-500 text-center mb-6">
            for <span class="font-semibold">
                <%= name %>
            </span>
        </p>

        <!-- Profile Picture -->
        <div class="flex flex-col items-center gap-3 mb-6">
            <!-- Preview Image -->
            <img src="<%= avatarUrl ? avatarUrl : '' %>" id="avatar_url"
                class="w-28 h-28 rounded-full object-cover border-4 border-blue-100"
                style="<%= avatarUrl ? '' : 'display:none' %>" />

            <!-- Placeholder when no avatar exists -->
            <div id="avatar_placeholder"
                class="w-28 h-28 rounded-full bg-gray-200 flex items-center justify-center text-gray-500 text-4xl"
                style="<%= avatarUrl ? 'display:none' : '' %>">
                <i class="fas fa-user"></i>
            </div>

            <!-- ALWAYS include remove button - hide if no avatar -->
            <button type="button" id="remove_button"
                class="text-red-500 hover:text-red-700 text-sm flex items-center gap-1"
                style="<%= avatarUrl ? '' : 'display:none' %>">
                <i class="fas fa-trash"></i> Remove Photo
            </button>
        </div>


        <!-- FORM -->
        <form action="/edit-profile" method="post" enctype="multipart/form-data" class="space-y-4">

            <input type="file" name="avatar" accept="image/*">
            <input type="hidden" name="removeAvatar" id="removeAvatar" value="false">

            <!-- Email -->
            <div>
                <label class="font-semibold text-gray-700">Email</label>
                <input type="email" name="email" value="<%= email %>" required
                    class="w-full p-2 border rounded-lg focus:ring focus:ring-blue-200" />
            </div>

            <!-- Name -->
            <div>
                <label class="font-semibold text-gray-700">Name</label>
                <input type="text" name="name" value="<%= name %>"
                    class="w-full p-2 border rounded-lg focus:ring focus:ring-blue-200" />
            </div>

            <!-- Errors -->
            <% if (errors && errors.length> 0) { %>
                <div class="space-y-2">
                    <% errors.forEach((item)=> { %>
                        <p class="p-2 bg-red-100 text-red-700 border border-red-300 rounded">
                            <%= item %>
                        </p>
                        <% }) %>
                </div>
                <% } %>

                    <!-- Submit Button -->
                    <button type="submit"
                        class="w-full py-2 bg-blue-600 hover:bg-blue-800 text-white font-medium rounded-lg transition">
                        Save Changes
                    </button>
        </form>

    </main>


    <script>

        const fileInput = document.querySelector('input[name="avatar"]');
        const previewImage = document.getElementById("avatar_url");
        const placeholder = document.getElementById("avatar_placeholder");
        const removeBtn = document.getElementById("remove_button");


        fileInput.addEventListener('change', () => {
            const file = fileInput.files[0];
            if (file) {
                previewImage.src = URL.createObjectURL(file);
                previewImage.style.display = "block";
                placeholder.style.display = "none";
                removeBtn.style.display = "inline-flex";
            }

        })

        if (removeBtn) {
            removeBtn.addEventListener("click", () => {
                previewImage.src = "";
                previewImage.style.display = "none";
                placeholder.style.display = "flex";
                fileInput.value = "";
                document.getElementById("removeAvatar").value = "true";
                removeBtn.style.display = "none";
            })

        }

    </script>

</body>

</html>