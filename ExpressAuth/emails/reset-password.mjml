<mjml>
  <mj-head>
    <mj-title>Email Verification</mj-title>
    <mj-preview>Verify your email to activate your account</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif"></mj-all>
      <mj-button background-color="#346DB7" color="white" border-radius="5px" padding="15px 25px"></mj-button>
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f0f0f0">
    <mj-section background-color="#ffffff" padding="20px" border-radius="10px" max-width="600px" margin="auto">
      <mj-column>
        <mj-text font-size="20px" font-weight="bold" align="center">Hello <%= name %>,</mj-text>
        <mj-text font-size="16px" color="#555" line-height="1.5">
          You can reset your passord by clicking the button below!
        </mj-text>

        <!-- Verification button -->
        <mj-button href="<%= verifyLink %>" align="center">
          Reset Password
        </mj-button>

        <mj-text font-size="16px" color="#555" line-height="1.5" padding-top="20px">
          Or, copy the verification token below and paste it on our website:
        </mj-text>

        <!-- Display token -->
        <mj-text font-size="24px" font-weight="bold" color="#346DB7" align="center" padding="10px 0">
          <%= token %>
        </mj-text>

        <mj-text font-size="14px" color="#888" line-height="1.5" padding-top="20px">
          This token will expire in 24 hours.
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section>
      <mj-column>
        <mj-text font-size="12px" color="#999" align="center">
          &copy; 2025 Complete node. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
